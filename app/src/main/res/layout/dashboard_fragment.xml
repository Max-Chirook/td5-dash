<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/tvWarmup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/card"
        android:letterSpacing="0.04"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="MOTEUR FROID" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <com.mooo.hairyone.td5tester.views.GaugeView
                android:id="@+id/gRPM"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                app:gaugeMin="0"
                app:gaugeMax="5000"
                app:gaugeDecimals="0"
                app:gaugeUnit="TR/MIN"
                app:gaugeHero="true"
                app:gaugeCaption="RÉGIME" />
            <com.mooo.hairyone.td5tester.views.GaugeView
                android:id="@+id/gTURBO"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                app:gaugeMin="0"
                app:gaugeMax="1.5"
                app:gaugeDecimals="2"
                app:gaugeUnit="BAR"
                app:gaugeCaption="TURBO" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <com.mooo.hairyone.td5tester.views.GaugeView
                android:id="@+id/gCOOLANT"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                app:gaugeMin="0"
                app:gaugeMax="130"
                app:gaugeDecimals="0"
                app:gaugeUnit="°C"
                app:gaugeCaption="T° MOTEUR" />
            <com.mooo.hairyone.td5tester.views.GaugeView
                android:id="@+id/gAIRFLOW"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                app:gaugeMin="0"
                app:gaugeMax="700"
                app:gaugeDecimals="0"
                app:gaugeUnit="KG/H"
                app:gaugeCaption="DÉBITMÈTRE" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <com.mooo.hairyone.td5tester.views.GaugeView
                android:id="@+id/gVOLT"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                app:gaugeMin="10"
                app:gaugeMax="16"
                app:gaugeDecimals="1"
                app:gaugeUnit="VOLT"
                app:gaugeCaption="BATTERIE" />
        </LinearLayout>
</LinearLayout>
