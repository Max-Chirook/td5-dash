<?xml version="1.0" encoding="utf-8"?>
<!-- The cluster in split screen: the same pieces as the wide layout, the two
     dials on top, fuel economy and the slow readings below them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="2dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="32dp">

        <TextView
            android:id="@+id/tvRange"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_vertical"
            android:paddingEnd="10dp"
            android:textColor="@color/labelSecondary"
            android:textSize="12sp"
            tools:text="AUTONOMIE   281 km   72 L" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTrip"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="14dp"
                android:gravity="center"
                android:letterSpacing="0.16"
                android:text="@string/trip_caps"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:letterSpacing="0.16"
                android:text="@string/total_caps"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- On its own line here: there is no room beside the switches. -->
    <TextView
        android:id="@+id/tvWarmup"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:letterSpacing="0.06"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="MONTÉE EN TEMPÉRATURE — 72 °C" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/hairline_fade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:orientation="horizontal">

        <com.mooo.hairyone.td5tester.views.ClusterDialView
            android:id="@+id/gRPM"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:gaugeMin="0"
            app:gaugeMax="5000"
            app:gaugeTickStep="1000"
            app:gaugeTickScale="1000"
            app:gaugeUnit="tr/min"
            app:gaugeCaption="Régime" />

        <com.mooo.hairyone.td5tester.views.ClusterDialView
            android:id="@+id/gTURBO"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:gaugeMin="0"
            app:gaugeMax="1.5"
            app:gaugeDecimals="2"
            app:gaugeTickStep="0.5"
            app:gaugeUnit="bar"
            app:gaugeCaption="Turbo" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/hairline_fade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:orientation="horizontal">

        <com.mooo.hairyone.td5tester.views.ReadoutView
            android:id="@+id/gFUEL"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:gaugeMin="0"
            app:gaugeMax="30"
            app:gaugeDecimals="1"
            app:gaugeUnit="L/100 km"
            app:gaugeCaption="Consommation" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <com.mooo.hairyone.td5tester.views.BarGaugeView
                android:id="@+id/gVOLT"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:gaugeMin="10"
                app:gaugeMax="16"
                app:gaugeDecimals="1"
                app:gaugeUnit="V"
                app:gaugeCaption="Batterie" />

            <com.mooo.hairyone.td5tester.views.BarGaugeView
                android:id="@+id/gCOOLANT"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:gaugeMin="0"
                app:gaugeMax="130"
                app:gaugeUnit="°C"
                app:gaugeCaption="Température moteur" />

            <com.mooo.hairyone.td5tester.views.BarGaugeView
                android:id="@+id/gAIRFLOW"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:gaugeMin="0"
                app:gaugeMax="700"
                app:gaugeUnit="kg/h"
                app:gaugeCaption="Débitmètre" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
