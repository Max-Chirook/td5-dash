<?xml version="1.0" encoding="utf-8"?>
<!-- Injector balance in split screen: the conditions on top, then the five
     cylinders as bars centred on zero. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvConditions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="6dp"
        android:letterSpacing="0.02"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="@string/inj_waiting"
        android:textColor="@color/labelTertiary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <include layout="@layout/injector_bars" />
</LinearLayout>
