<?xml version="1.0" encoding="utf-8"?>
<!-- The five injector balances as columns side by side in one tile, sharing
     the green ideal band and the zero line. Shared by both layouts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="6dp"
    android:paddingBottom="4dp">

    <com.mooo.hairyone.td5tester.views.ColumnGaugeView
        android:id="@+id/gPOWER_BALANCE_1"
        style="@style/InjectorColumn"
        app:gaugeScaleMarks="true"
        app:gaugeCaption="Inj. 1" />

    <com.mooo.hairyone.td5tester.views.ColumnGaugeView
        android:id="@+id/gPOWER_BALANCE_2"
        style="@style/InjectorColumn"
        app:gaugeCaption="Inj. 2" />

    <com.mooo.hairyone.td5tester.views.ColumnGaugeView
        android:id="@+id/gPOWER_BALANCE_3"
        style="@style/InjectorColumn"
        app:gaugeCaption="Inj. 3" />

    <com.mooo.hairyone.td5tester.views.ColumnGaugeView
        android:id="@+id/gPOWER_BALANCE_4"
        style="@style/InjectorColumn"
        app:gaugeCaption="Inj. 4" />

    <com.mooo.hairyone.td5tester.views.ColumnGaugeView
        android:id="@+id/gPOWER_BALANCE_5"
        style="@style/InjectorColumn"
        app:gaugeCaption="Inj. 5" />
</LinearLayout>
