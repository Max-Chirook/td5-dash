<?xml version="1.0" encoding="utf-8"?>
<!-- The five injector balances, centred on zero, shared by both layouts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <com.mooo.hairyone.td5tester.views.BarGaugeView
        android:id="@+id/gPOWER_BALANCE_1"
        style="@style/ClusterBar"
        app:gaugeMin="-15"
        app:gaugeMax="15"
        app:gaugeDecimals="1"
        app:gaugeCaption="Injecteur 1" />

    <com.mooo.hairyone.td5tester.views.BarGaugeView
        android:id="@+id/gPOWER_BALANCE_2"
        style="@style/ClusterBar"
        app:gaugeMin="-15"
        app:gaugeMax="15"
        app:gaugeDecimals="1"
        app:gaugeCaption="Injecteur 2" />

    <com.mooo.hairyone.td5tester.views.BarGaugeView
        android:id="@+id/gPOWER_BALANCE_3"
        style="@style/ClusterBar"
        app:gaugeMin="-15"
        app:gaugeMax="15"
        app:gaugeDecimals="1"
        app:gaugeCaption="Injecteur 3" />

    <com.mooo.hairyone.td5tester.views.BarGaugeView
        android:id="@+id/gPOWER_BALANCE_4"
        style="@style/ClusterBar"
        app:gaugeMin="-15"
        app:gaugeMax="15"
        app:gaugeDecimals="1"
        app:gaugeCaption="Injecteur 4" />

    <com.mooo.hairyone.td5tester.views.BarGaugeView
        android:id="@+id/gPOWER_BALANCE_5"
        style="@style/ClusterBar"
        app:gaugeMin="-15"
        app:gaugeMax="15"
        app:gaugeDecimals="1"
        app:gaugeCaption="Injecteur 5" />
</LinearLayout>
