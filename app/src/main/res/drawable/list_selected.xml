<?xml version="1.0" encoding="utf-8"?>
<!-- The selected line of a list: barely lighter, a white mark on its left. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0DFFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:gravity="start|fill_vertical" android:width="2.5dp" android:top="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/inkStrong" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
