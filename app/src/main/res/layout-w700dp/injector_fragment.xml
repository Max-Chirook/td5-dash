<?xml version="1.0" encoding="utf-8"?>
<!-- Injector balance on a wide screen: the five cylinders as bars centred
     on zero on the left, the conditions and how to read them on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.7"
        android:layout_marginEnd="32dp"
        android:orientation="vertical">

        <TextView
            style="@style/ClusterSection"
            android:text="@string/sec_injectors" />

        <include layout="@layout/injector_bars" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            style="@style/ClusterSection"
            android:text="@string/sec_conditions" />

        <TextView
            android:id="@+id/tvConditions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:letterSpacing="0.04"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/inj_waiting"
            android:textColor="@color/labelTertiary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/injector_hint_title"
            android:textColor="@color/labelSecondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/injector_hint_body"
            android:textColor="@color/labelTertiary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
