<?xml version="1.0" encoding="utf-8"?>
<!-- Injector balance on a wide screen: the five cylinders as rails centred
     on zero on the left, the conditions and how to read them on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.8"
        android:orientation="vertical">

        <TextView style="@style/ClusterSection" android:text="@string/sec_injectors" />
        <View style="@style/SectionRule" />

        <include layout="@layout/injector_bars" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:background="@color/hairline" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView style="@style/ClusterSection" android:text="@string/sec_conditions" />
        <View style="@style/SectionRule" />

        <TextView
            android:id="@+id/tvConditions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/inj_waiting"
            android:textColor="@color/labelTertiary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            style="@style/ClusterSection"
            android:layout_marginTop="22dp"
            android:text="@string/sec_howto" />
        <View style="@style/SectionRule" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="@string/injector_hint_body"
            android:textColor="#A8A8AE"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView style="@style/ClusterSection" android:text="@string/sec_worst" />
        <View style="@style/SectionRule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWorstName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="—"
                android:textColor="@color/ink"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvWorstValue"
                style="@style/BigFigure"
                android:textSize="30sp"
                android:text="—" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
