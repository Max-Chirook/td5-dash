<?xml version="1.0" encoding="utf-8"?>
<!-- Driver display: engine speed and turbo as round instruments, fuel economy
     and the gear between them, the slow readings as fine bars along the foot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="4dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="36dp">

        <!-- Range left in the tank; a touch opens the fill-up screen. -->
        <TextView
            android:id="@+id/tvRange"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_vertical"
            android:paddingEnd="16dp"
            android:textColor="@color/labelSecondary"
            android:textSize="13sp"
            tools:text="AUTONOMIE   281 km   72 L" />

        <!-- The warm-up note, or "BRIDÉ" while a limiter holds the fuel back. -->
        <TextView
            android:id="@+id/tvWarmup"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:background="@drawable/pill_warn"
            tools:textColor="@color/stateHigh"
            tools:visibility="visible"
            tools:text="⚠  BRIDÉ · FUMÉE" />

        <!-- Trip or long-term total in the grey lines; a long press on
             "Total" offers to reset it. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTrip"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="18dp"
                android:gravity="center"
                android:letterSpacing="0.16"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/trip_caps"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_gravity="center_vertical"
                android:gravity="center"
                android:letterSpacing="0.16"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="@string/total_caps"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/hairline_fade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal">

        <com.mooo.hairyone.td5tester.views.ClusterDialView
            android:id="@+id/gRPM"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:gaugeMin="0"
            app:gaugeMax="5000"
            app:gaugeTickStep="1000"
            app:gaugeTickScale="1000"
            app:gaugeUnit="tr/min"
            app:gaugeCaption="Régime" />

        <com.mooo.hairyone.td5tester.views.ReadoutView
            android:id="@+id/gFUEL"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.62"
            app:gaugeMin="0"
            app:gaugeMax="30"
            app:gaugeDecimals="1"
            app:gaugeUnit="L/100 km"
            app:gaugeCaption="Consommation" />

        <com.mooo.hairyone.td5tester.views.ClusterDialView
            android:id="@+id/gTURBO"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:gaugeMin="0"
            app:gaugeMax="1.5"
            app:gaugeDecimals="2"
            app:gaugeTickStep="0.5"
            app:gaugeUnit="bar"
            app:gaugeCaption="Turbo" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/hairline_fade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:orientation="horizontal">

        <com.mooo.hairyone.td5tester.views.BarGaugeView
            android:id="@+id/gVOLT"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="30dp"
            app:gaugeMin="10"
            app:gaugeMax="16"
            app:gaugeDecimals="1"
            app:gaugeUnit="V"
            app:gaugeCaption="Batterie" />

        <com.mooo.hairyone.td5tester.views.BarGaugeView
            android:id="@+id/gCOOLANT"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="30dp"
            app:gaugeMin="0"
            app:gaugeMax="130"
            app:gaugeUnit="°C"
            app:gaugeCaption="Température moteur" />

        <com.mooo.hairyone.td5tester.views.BarGaugeView
            android:id="@+id/gAIRFLOW"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:gaugeMin="0"
            app:gaugeMax="700"
            app:gaugeUnit="kg/h"
            app:gaugeCaption="Débitmètre" />
    </LinearLayout>

</LinearLayout>
