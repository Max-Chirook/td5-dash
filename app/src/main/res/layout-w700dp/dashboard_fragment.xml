<?xml version="1.0" encoding="utf-8"?>
<!-- A digital cluster: the two quick readings as large dials, fuel economy
     between them, and the slow readings as bars along the foot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="34dp">

        <TextView
            android:id="@+id/tvWarmup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/card"
            android:letterSpacing="0.04"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="MONTÉE EN TEMPÉRATURE — 72 °C" />

        <!-- Trip or long-term total in the grey lines; a long press on
             "Total" offers to reset it. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/toggle_track"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/tvTrip"
                android:layout_width="76dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/trip"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="76dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/total"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.mooo.hairyone.td5tester.views.ClusterDialView
            android:id="@+id/gRPM"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:gaugeMin="0"
            app:gaugeMax="5000"
            app:gaugeTickStep="1000"
            app:gaugeTickScale="1000"
            app:gaugeUnit="tr/min"
            app:gaugeCaption="Régime" />

        <com.mooo.hairyone.td5tester.views.ReadoutView
            android:id="@+id/gFUEL"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            app:gaugeMin="0"
            app:gaugeMax="30"
            app:gaugeDecimals="1"
            app:gaugeUnit="L/100 km"
            app:gaugeCaption="Conso" />

        <com.mooo.hairyone.td5tester.views.ClusterDialView
            android:id="@+id/gTURBO"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:gaugeMin="0"
            app:gaugeMax="1.5"
            app:gaugeDecimals="2"
            app:gaugeTickStep="0.5"
            app:gaugeUnit="bar"
            app:gaugeCaption="Turbo" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="6dp"
        android:background="@color/surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:orientation="horizontal">

        <com.mooo.hairyone.td5tester.views.BarGaugeView
            android:id="@+id/gVOLT"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="20dp"
            app:gaugeMin="10"
            app:gaugeMax="16"
            app:gaugeDecimals="1"
            app:gaugeUnit="V"
            app:gaugeCaption="Batterie" />

        <com.mooo.hairyone.td5tester.views.BarGaugeView
            android:id="@+id/gCOOLANT"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="20dp"
            app:gaugeMin="0"
            app:gaugeMax="130"
            app:gaugeUnit="°C"
            app:gaugeCaption="T° moteur" />

        <com.mooo.hairyone.td5tester.views.BarGaugeView
            android:id="@+id/gAIRFLOW"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:gaugeMin="0"
            app:gaugeMax="700"
            app:gaugeUnit="kg/h"
            app:gaugeCaption="Débitmètre" />
    </LinearLayout>

</LinearLayout>
